    <string name="guide_title">User Guide</string>
    <string name="guide_about_section_title">About</string>
    <string name="guide_about_intro">This app is developed by HackingGroup.</string>
    <string name="guide_about_official_sites_label">Official Website:</string>
    <string name="guide_about_site_cn">Chinese https://hackinggroup.org.cn</string>
    <string name="guide_about_site_en">English https://hackinggroup.org</string>
    <string name="guide_about_wechat_qr_label">Follow Us</string>
    <string name="guide_about_wechat_qr_cd">HackingGroup WeChat QR Code</string>
    <string name="guide_about_disclaimer">This app is fully standalone: it does not upload data or access the internet. All information stays on your device. Fully open-source — feel free to audit the code. Please use only for security research and educational purposes in compliance with local laws.</string>
    <string name="guide_section_easy_title">Easy Mode: No ADB Required</string>
    <string name="guide_easy_intro">Get started immediately: grant overlay and notification permissions, then tap Start Monitoring.</string>
    <string name="guide_easy_step_overlay">Overlay: Used to display alerts at the top of the screen. Please allow \"Display over other apps\" in system settings.</string>
    <string name="guide_easy_step_notifications">Notifications: Used to send privacy alerts. Please allow this app to send notifications in system settings.</string>
    <string name="guide_easy_step_limits">Limitations: In easy mode, the camera cannot reliably identify which app is using it (will show as \"Unknown App\"). The microphone can resolve package names on most Android 10+ devices. Location, contacts, and SMS access require ADB authorization for precise mode.</string>
    <string name="guide_section_advanced_title">Advanced (Optional): ADB Precise Mode</string>
    <string name="guide_advanced_intro">To precisely identify which app is accessing camera, location, contacts, or SMS via AppOps, run the following command via USB debugging or wireless debugging (one-time setup). Skip this section if you don\'t need it.</string>
    <string name="guide_step_dev">1. Enable Developer Options and turn on USB debugging or Wireless debugging</string>
    <string name="guide_step_adb">2. Run the following command on your computer or wireless debugging terminal (pre-filled with this app\'s package name)</string>
    <string name="guide_usage_stats_hint">Optional: Grant Usage Stats access in Settings → Special app permissions → Usage access for more accurate foreground/background detection.</string>
